# ---------------------------------------------------------------------------
# LLM Mode configuration (OPTIONAL)
# ---------------------------------------------------------------------------
# The app runs fully in Mock Mode with NO API key. To try LLM Mode:
#
#   1. Copy this file and rename the copy to ".env"  (just ".env", no name).
#   2. Paste your API key after LLM_API_KEY= below.
#   3. Pick your provider and (optionally) a model.
#   4. Restart the app.
#
# Your ".env" file is git-ignored, so your key is never committed or pushed.
# ---------------------------------------------------------------------------

# --- Required to enable LLM Mode -------------------------------------------
# Paste your secret key here (no quotes needed). Leave blank to stay in Mock Mode.
LLM_API_KEY=

# --- Which provider the key belongs to -------------------------------------
# Options: openai | azure | anthropic
LLM_PROVIDER=openai

# --- Optional: pick a specific model ---------------------------------------
# Leave blank to use a sensible default:
#   openai    -> gpt-4o-mini
#   anthropic -> claude-3-5-sonnet-latest
#   azure     -> (must be your deployment name; set it below)
LLM_MODEL=

# ---------------------------------------------------------------------------
# Azure OpenAI only (ignore these two lines unless LLM_PROVIDER=azure)
# ---------------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-06-01
